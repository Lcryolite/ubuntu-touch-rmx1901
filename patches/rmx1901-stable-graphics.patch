@@ -425,0 +460,22 @@
+
+cat >"${rootmnt}/userdata/systemd249/rmx1901-wait-user-bus.sh" <<'EOF'
+#!/bin/sh
+set -u
+log=/run/rmxcache/user-session-ready.log
+mkdir -p "$(dirname "$log")"
+i=0
+while [ "$i" -lt 100 ]; do
+    if [ -S /run/user/32011/bus ] && \
+       /usr/sbin/runuser -u phablet -- env \
+           XDG_RUNTIME_DIR=/run/user/32011 \
+           DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/32011/bus \
+           /usr/bin/systemctl --user list-units >/dev/null 2>&1; then
+        echo "phablet user bus ready after ${i}00ms" >"$log"
+        exit 0
+    fi
+    i=$((i + 1))
+    sleep 0.1
+done
+echo "phablet user bus readiness timeout" >"$log"
+exit 1
+EOF
