+Restart=on-failure
+RestartSec=1
+EOF
+
+
+cat >"${rootmnt}/etc/systemd/system/rmx1901-user-session-ready.service" <<'EOF'
+[Unit]
+Description=Prepare phablet user manager and session bus for LightDM
+Requires=user-runtime-dir@32011.service user@32011.service
+After=systemd-user-sessions.service user-runtime-dir@32011.service user@32011.service
+Before=lightdm.service
+
+[Service]
+Type=oneshot
+ExecStart=/userdata/systemd249/rmx1901-wait-user-bus.sh
+RemainAfterExit=yes
+EOF
+
