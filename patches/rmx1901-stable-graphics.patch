@@ -370,0 +375,29 @@
+
+# Start phablet's user manager before LightDM and expose its bus explicitly.
+# A matching systemd 249 logind still creates the real seat0/Mir PAM session.
+var_systemd_dir="${rootmnt}/var/lib/systemd"
+var_systemd_save=/tmp/rmx1901-var-lib-systemd
+rm -rf "$var_systemd_save"
+mkdir -p "$var_systemd_save"
+cp -a "$var_systemd_dir"/. "$var_systemd_save"/
+mount -t tmpfs -o mode=755 tmpfs "$var_systemd_dir" || panic "RMX1901 var/lib/systemd tmpfs mount failed"
+cp -a "$var_systemd_save"/. "$var_systemd_dir"/
+rm -rf "${rootmnt}/userdata/rmx1901-linger"
+mkdir -p "${rootmnt}/userdata/rmx1901-linger" "$var_systemd_dir/linger"
+touch "${rootmnt}/userdata/rmx1901-linger/phablet"
+mount -n -o bind "${rootmnt}/userdata/rmx1901-linger" "$var_systemd_dir/linger" || panic "RMX1901 phablet linger bind failed"
+{
+    IFS= read -r first_line
+    printf '%s\n' "$first_line"
+    cat <<'EOF'
+if [ "$(id -u)" = 32011 ]; then
+    export XDG_RUNTIME_DIR=/run/user/32011
+    export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/32011/bus
+    export HYBRIS_LD_LIBRARY_PATH=/vendor/lib64/hw:/vendor/lib64/egl:/vendor/lib64:/system/lib64
+fi
+EOF
+    cat
+} <"${rootmnt}/usr/sbin/ubuntu-touch-lightdm-session" >"${rootmnt}/userdata/systemd249/ubuntu-touch-lightdm-session"
+chmod 0755 "${rootmnt}/userdata/systemd249/ubuntu-touch-lightdm-session"
+mount -n -o bind "${rootmnt}/userdata/systemd249/ubuntu-touch-lightdm-session" "${rootmnt}/usr/sbin/ubuntu-touch-lightdm-session" || panic "RMX1901 LightDM session environment bind failed"
+
