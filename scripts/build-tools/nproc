#!/usr/bin/env bash
set -euo pipefail

limit="${RMX1901_BUILD_JOBS:-4}"
[[ "$limit" =~ ^[1-9][0-9]*$ ]] || {
  printf 'RMX1901_BUILD_JOBS must be a positive integer\n' >&2
  exit 2
}

actual="$(/usr/bin/nproc --all)"
if test "$actual" -lt "$limit"; then
  printf '%s\n' "$actual"
else
  printf '%s\n' "$limit"
fi
