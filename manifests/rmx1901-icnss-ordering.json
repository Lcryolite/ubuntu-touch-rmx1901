{
  "schema": "rmx1901-icnss-ordering-v1",
  "status": "source-proven",
  "conclusion": {
    "pre_hal_gate": "Require the ICNSS platform device and /dev/wlan control node, but do not require REGISTER_DRIVER, FW_READY, driver probe, wlan0, or PHY counters before a client invokes IWifi.start().",
    "trigger": "A client call to android.hardware.wifi@1.0::IWifi.start, not HIDL service registration alone, begins the driver-load chain.",
    "post_trigger_gate": "After exactly one accepted IWifi.start call, require the /dev/wlan ON write, ICNSS REGISTER_DRIVER posted/processed, WLFW/FW_READY progress, successful qcacld probe, and a real WLAN interface within the bounded P5 window.",
    "fw_ready_order": "ICNSS accepts either order: REGISTER_DRIVER stores ops and waits when firmware is not ready; FW_READY later calls probe. If FW_READY exists first, REGISTER_DRIVER calls probe immediately."
  },
